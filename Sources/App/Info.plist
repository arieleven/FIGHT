			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fightplan</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.shon.fight.result</string>
			<key>UTTypeDescription</key>
			<string>FIGHT Session Result</string>
